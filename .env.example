# ============================================
# Smart EDU — Environment Configuration Example
# Replace {{placeholders}} with real deployment values.
# ============================================

NODE_ENV=development

# Institution Placeholders
UNIVERSITY_NAME="{{university_name}}"
UNIVERSITY_SHORT_NAME="{{university_short_name}}"
INSTITUTION_DOMAIN="{{institution_domain}}"
SUPPORT_EMAIL="{{support_email}}"
DEFAULT_CURRENCY=USD
DEFAULT_TIMEZONE=UTC
SECOND_LANGUAGE=ar

# Database (Supabase PostgreSQL — sole database)
# Copy from Supabase Dashboard -> Connect -> ORMs (Prisma):
# - DATABASE_URL: Transaction Pooler (port 6543, ?pgbouncer=true&connection_limit=1&sslmode=require)
# - DIRECT_URL:   Session Pooler or Direct Postgres (port 5432, ?sslmode=require) for Prisma migrations/db push
DATABASE_URL="postgresql://postgres.{{supabase_project_ref}}:{{supabase_db_password}}@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres.{{supabase_project_ref}}:{{supabase_db_password}}@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Redis (Cache, Pub/Sub, BullMQ)
REDIS_URL="redis://localhost:6379"
ENABLE_LOCAL_NO_REDIS_DEV=false

# API Server
API_PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN="http://localhost:3000"

# Auth & Cryptography (Use 32+ char cryptographically random secrets in production)
JWT_ACCESS_SECRET="change_me_dev_jwt_access_secret_min_32_chars_123456"
JWT_REFRESH_SECRET="change_me_dev_jwt_refresh_secret_min_32_chars_123456"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
MFA_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# OAuth / OIDC SSO (Google & Microsoft)
GOOGLE_CLIENT_ID="{{google_oauth_client_id}}"
GOOGLE_CLIENT_SECRET="{{google_oauth_client_secret}}"
MICROSOFT_CLIENT_ID="{{microsoft_oauth_client_id}}"
MICROSOFT_CLIENT_SECRET="{{microsoft_oauth_client_secret}}"
SSO_REDIRECT_URI="http://localhost:3000/api/auth/sso/callback"

# S3-Compatible Object Storage (MinIO in local Docker)
S3_ENDPOINT="http://localhost:9000"
S3_REGION=us-east-1
S3_BUCKET=smart-edu-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123

# Email (SMTP / Mailpit in local Docker)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Smart EDU <noreply@{{institution_domain}}>"

# Push Notifications (FCM)
FIREBASE_PROJECT_ID="{{fcm_project_id}}"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Payments (Stripe Adapter)
STRIPE_PUBLISHABLE_KEY="{{stripe_publishable_key}}"
STRIPE_SECRET_KEY="{{stripe_secret_key}}"
STRIPE_WEBHOOK_SECRET="{{stripe_webhook_secret}}"

# Web Console (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_WS_URL="ws://localhost:4000/ws"
NEXT_PUBLIC_APP_NAME="Smart EDU"
