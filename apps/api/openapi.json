  "info": {
    "title": "Smart EDU API",
    "description": "Unified API for Smart EDU Console and Smart EDU Mobile App",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "nusrat.jahan@university.edu"
          },
          "password": {
            "type": "string",
            "example": "SmartEdu#2026"
          },
          "platform": {
            "type": "string",
            "example": "web"
          },
          "deviceName": {
            "type": "string",
            "example": "Chrome on Windows"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "VerifyMfaDto": {
        "type": "object",
        "properties": {
          "mfaToken": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "example": "123456"
          },
          "platform": {
            "type": "string",
            "example": "web"
          },
          "deviceName": {
            "type": "string",
            "example": "Chrome on Windows"
          }
        },
        "required": [
          "mfaToken",
          "code"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "SwitchRoleDto": {
        "type": "object",
        "properties": {
          "assignmentId": {
            "type": "string"
          }
        },
        "required": [
          "assignmentId"
        ]
      },
      "PreviewRoleDto": {
        "type": "object",
        "properties": {
          "roleId": {
            "type": "string"
          }
        },
        "required": [
          "roleId"
        ]
      },
      "CreateRoleDto": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "example": "department_coordinator"
          },
          "name": {
            "type": "string",
            "example": "Department coordinator"
          },
          "tier": {
            "type": "string",
            "example": "SUB_ADMIN"
          },
          "description": {
            "type": "string"
          },
          "permissionIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "slug",
          "name",
          "permissionIds"
        ]
      },
      "UpdateRolePermissionsDto": {
        "type": "object",
        "properties": {
          "permissionIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "permissionIds"
        ]
      },
      "AssignUserRoleDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "roleId": {
            "type": "string"
          },
          "campusId": {
            "type": "string"
          },
          "departmentCode": {
            "type": "string",
            "example": "CSE"
          },
          "programCode": {
            "type": "string",
            "example": "BSC-CSE"
          },
          "scopeType": {
            "type": "string",
            "enum": [
              "own",
              "section",
              "department",
              "program",
              "campus",
              "institution"
            ]
          },
          "isActing": {
            "type": "boolean"
          },
          "validFrom": {
            "type": "string"
          },
          "validTo": {
            "type": "string"
          }
        },
        "required": [
          "userId",
          "roleId",
          "scopeType"
        ]
      },
      "DecideApprovalDto": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "APPROVED",
              "REJECTED"
            ]
          },
          "comment": {
            "type": "string"
          }
        },
        "required": [
          "decision"
        ]
      },
      "UpdateInstitutionDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "shortName": {
            "type": "string"
          },
          "supportEmail": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "defaultCurrency": {
            "type": "string"
          }
        }
      },
      "CreateCampusDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "MAIN-NORTH"
          },
          "name": {
            "type": "string",
            "example": "North Engineering Campus"
          },
          "address": {
            "type": "string"
          },
          "timezone": {
            "type": "string",
            "example": "UTC"
          }
        },
        "required": [
          "code",
          "name"
        ]
      },
      "ToggleFeatureFlagDto": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "enabled"
        ]
      }
    }
  }
}
